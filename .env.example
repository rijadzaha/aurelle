# Copy this file to a new file named ".env" (no ".example") and paste your keys in.
# The .env file is ignored by git, so your keys are never uploaded.

# From https://console.anthropic.com -> API Keys
AURELLE_ANTHROPIC_KEY=paste-your-anthropic-key-here

# From https://fal.ai/dashboard/keys
FAL_KEY=paste-your-fal-key-here

# --- Optional settings (you can leave these as they are) ---

# Which video model to use. Choices are listed in engine/video_models.py
VIDEO_MODEL=kling-2.5-turbo-pro

# Which Claude model labels the photos
CLAUDE_MODEL=claude-opus-5-5

# How many clips to make at the same time
MAX_PARALLEL_CLIPS=4

# Music loudness: 1.0 = as supplied, 0.5 = half as loud
MUSIC_VOLUME=0.6
